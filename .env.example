# Settings of an installation. All are optional: with none, the tool listens on http://127.0.0.1:8787,
# reachable from this machine only, and keeps its data in ./data. docs/deployment.md explains each.

# Where every TARA is kept. Back this folder up.
# TARA_DATA_DIR=./data

# The address and port the tool listens on. 127.0.0.1: this machine only. 0.0.0.0: every network interface.
# HOST=127.0.0.1
# PORT=8787

# The host names the tool may be reached by, comma-separated. Set this when HOST is not 127.0.0.1.
# TARA_ALLOWED_HOSTS=tara.example.org

# The request header in which your reverse proxy passes on the name of the signed-in person.
# Only set this when the tool can be reached through that proxy and in no other way.
# TARA_USER_HEADER=X-Forwarded-User
